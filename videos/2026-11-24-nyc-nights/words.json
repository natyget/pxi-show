 "duration": 34.625,
 "lines": [
  {
   "i": 0,
   "s": 0.25,
   "e": 3.875,
   "text": "Are you in New York, looking for things to do this weekend? We got you.",
   "groups": [
    5,
    5,
    2,
    3
   ]
  },
  {
   "i": 1,
   "s": 4.025,
   "e": 7.075,
   "text": "First, can you skate? Because there's a skate night this Saturday.",
   "groups": [
    1,
    3,
    5,
    2
   ]
  },
  {
   "i": 2,
   "s": 7.225,
   "e": 11.4,
   "text": "Xanadu, in Brooklyn, with Rich Medina. Seven o'clock, twenty-five dollars.",
   "groups": [
    1,
    2,
    3,
    2,
    2
   ]
  },
  {
   "i": 3,
   "s": 11.55,
   "e": 14.4,
   "text": "If you'd rather stay on your feet, Friday is for dancing.",
   "groups": [
    3,
    4,
    2,
    2
   ]
  },
  {
   "i": 4,
   "s": 14.55,
   "e": 18.45,
   "text": "Marco Leece, at the Public Hotel. House music from eight, twenty dollars.",
   "groups": [
    2,
    4,
    2,
    2,
    2
   ]
  },
  {
   "i": 5,
   "s": 18.6,
   "e": 20.375,
   "text": "Sunday starts before you're ready.",
   "groups": [
    2,
    3
   ]
  },
  {
   "i": 6,
   "s": 20.525,
   "e": 25.775,
   "text": "An unlimited prosecco cruise, at Pier 36. Eleven A.M., about nineteen dollars.",
   "groups": [
    2,
    2,
    3,
    2,
    3
   ]
  },
  {
   "i": 7,
   "s": 25.925,
   "e": 27.575,
   "text": "And when the money runs out,",
   "groups": [
    2,
    4
   ]
  },
  {
   "i": 8,
   "s": 27.725,
   "e": 31.05,
   "text": "there's Reggaeton on Houston. Sunday at five, and it's free.",
   "groups": [
    4,
    3,
    3
   ]
  },
  {
   "i": 9,
   "s": 31.2,
   "e": 33.725,
   "text": "All four are in Pixie. Which one are you going to?",
   "groups": [
    2,
    3,
    2,
    4
   ]
  }
 ],
