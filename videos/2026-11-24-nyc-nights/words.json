 "duration": 37.1,
 "lines": [
  {
   "i": 0,
   "s": 0.25,
   "e": 3.875,
   "text": "Are you in New York, looking for things to do this weekend? We got you.",
   "groups": [
    5,
    5,
    2,
    3
   ]
  },
  {
   "i": 1,
   "s": 4.025,
   "e": 7.075,
   "text": "First, can you skate? Because there's a skate night this Saturday.",
   "groups": [
    1,
    3,
    5,
    2
   ]
  },
  {
   "i": 2,
   "s": 7.225,
   "e": 11.4,
   "text": "Xanadu, in Brooklyn, with Rich Medina. Seven o'clock, twenty-five dollars.",
   "groups": [
    1,
    2,
    3,
    2,
    2
   ]
  },
  {
   "i": 3,
   "s": 11.55,
   "e": 14.4,
   "text": "If you'd rather stay on your feet, Friday is for dancing.",
   "groups": [
    3,
    4,
    2,
    2
   ]
  },
  {
   "i": 4,
   "s": 14.55,
   "e": 19.475,
   "text": "Marco Leece, in ArtSpace at the Public Hotel. House music from ten, twenty dollars.",
   "groups": [
    2,
    2,
    4,
    2,
    2,
    2
   ]
  },
  {
   "i": 5,
   "s": 19.625,
   "e": 21.4,
   "text": "Sunday starts before you're ready.",
   "groups": [
    2,
    3
   ]
  },
  {
   "i": 6,
   "s": 21.55,
   "e": 26.8,
   "text": "An unlimited prosecco cruise, at Pier 36. Eleven A.M., about nineteen dollars.",
   "groups": [
    2,
    2,
    3,
    2,
    3
   ]
  },
  {
   "i": 7,
   "s": 26.95,
   "e": 28.6,
   "text": "And when the money runs out,",
   "groups": [
    2,
    4
   ]
  },
  {
   "i": 8,
   "s": 28.75,
   "e": 32.55,
   "text": "there's a free rave with an arcade. Saturday at nine, at Danger Danger.",
   "groups": [
    4,
    3,
    3,
    3
   ]
  },
  {
   "i": 9,
   "s": 32.7,
   "e": 35.4,
   "text": "All of these are in Pixie. Which one are you going to?",
   "groups": [
    3,
    3,
    2,
    4
   ]
  }
 ],
