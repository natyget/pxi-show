{
 "duration": 30.064,
 "lines": [
  {
   "i": 0,
   "s": 0.25,
   "e": 2.125,
   "text": "Wait. You two are the strangers?",
   "groups": [
    1,
    3,
    2
   ],
   "who": "nio",
   "file": "vo/line00.wav"
  },
  {
   "i": 1,
   "s": 2.225,
   "e": 5.001,
   "text": "Nio, we came here to get away from you.",
   "groups": [
    1,
    3,
    3,
    2
   ],
   "who": "maya",
   "file": "vo/line01.wav"
  },
  {
   "i": 2,
   "s": 5.151,
   "e": 8.007,
   "text": "It says dinner with strangers. Right here on my app.",
   "groups": [
    3,
    2,
    2,
    3
   ],
   "who": "nio",
   "file": "vo/line02.wav"
  },
  {
   "i": 3,
   "s": 8.157,
   "e": 11.6,
   "text": "Hi, I'm Theo. I have never met you in my life.",
   "groups": [
    3,
    3,
    3,
    2
   ],
   "who": "theo",
   "file": "vo/line03.wav"
  },
  {
   "i": 4,
   "s": 11.75,
   "e": 14.618,
   "text": "Theo, you owe me two months of rent.",
   "groups": [
    1,
    3,
    2,
    2
   ],
   "who": "nio",
   "file": "vo/line04.wav"
  },
  {
   "i": 5,
   "s": 14.768,
   "e": 17.03,
   "text": "See, a stranger would never bring that up.",
   "groups": [
    1,
    3,
    2,
    2
   ],
   "who": "theo",
   "file": "vo/line05.wav"
  },
  {
   "i": 6,
   "s": 17.18,
   "e": 21.211,
   "text": "Fine. We're all new here. Hi, I'm Maya.",
   "groups": [
    1,
    2,
    2,
    3
   ],
   "who": "maya",
   "file": "vo/line06.wav"
  },
  {
   "i": 7,
   "s": 21.361,
   "e": 24.315,
   "text": "I'm Nio. I built the app that did this to us.",
   "groups": [
    2,
    3,
    3,
    3
   ],
   "who": "nio",
   "file": "vo/line07.wav"
  },
  {
   "i": 8,
   "s": 24.515,
   "e": 27.464,
   "text": "Oh my god. Look. An actual stranger.",
   "groups": [
    3,
    1,
    3
   ],
   "who": "maya",
   "file": "vo/line08.wav"
  }
 ],
