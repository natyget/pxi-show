 "lines": [
  {
   "i": 0,
   "s": 0.25,
   "e": 3.375,
   "text": "Boston has heated igloos this weekend."
  },
  {
   "i": 1,
   "s": 3.675,
   "e": 9.95,
   "text": "They're at the Sam Adams brewery, Saturday and Sunday from noon. Twenty-eight forty-five."
  },
  {
   "i": 2,
   "s": 10.25,
   "e": 15.775,
   "text": "Three more. Friday at seven, Black Friday Funk at Spy Bar, and it's free."
  },
  {
   "i": 3,
   "s": 16.075,
   "e": 22.15,
   "text": "After that, No Wall Huggers at Bootleg Special. It starts at ten and costs twenty."
  },
  {
   "i": 4,
   "s": 22.45,
   "e": 27.55,
   "text": "And Saturday at one, Matcha Madness at Hue. Also twenty dollars."
  },
  {
   "i": 5,
   "s": 28.0,
   "e": 31.625,
   "text": "There's more where those came from. It's all in Pixie."
  },
  {
   "i": 6,
   "s": 31.925,
   "e": 34.45,
   "text": "Who are you bringing to the igloo?"
  }
 ],
