  {
   "i": 0,
   "s": 0.25,
   "e": 4.125,
   "text": "Your phone just told on you. Seven hours a day."
  },
  {
   "i": 1,
   "s": 4.725,
   "e": 8.775,
   "text": "Sunday, one P.M., and you still haven't left the couch."
  },
  {
   "i": 2,
   "s": 9.125,
   "e": 13.275,
   "text": "You open Pixie, looking for a reason to put it down."
  },
  {
   "i": 3,
   "s": 13.575,
   "e": 19.85,
   "text": "There's an all day party at Nowadays, a Giants watch party, and reggaeton on Howston."
  },
  {
   "i": 4,
   "s": 20.15,
   "e": 23.375,
   "text": "You tap join, and you're off the couch by two."
  },
  {
   "i": 5,
   "s": 23.775,
   "e": 26.975,
   "text": "By five, you forgot you even had a phone."
  },
  {
   "i": 6,
   "s": 27.525,
   "e": 31.15,
   "text": "Next Sunday, screen time's up twelve percent."
  },
  {
   "i": 7,
   "s": 32.45,
   "e": 34.875,
   "text": "What's on near you this Sunday?"
  }
 ],
