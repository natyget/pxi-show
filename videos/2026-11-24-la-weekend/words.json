{
 "duration": 33.525,
 "lines": [
  {
   "i": 0,
   "s": 0.25,
   "e": 3.8,
   "text": "Are you in L.A., looking for things to do this weekend? We got you.",
   "groups": [
    4,
    5,
    2,
    3
   ]
  },
  {
   "i": 1,
   "s": 3.95,
   "e": 6.975,
   "text": "Friday, you can have dinner with strangers in Echo Park.",
   "groups": [
    1,
    4,
    2,
    3
   ]
  },
  {
   "i": 2,
   "s": 7.125,
   "e": 11.125,
   "text": "It's called Foodies and New Friends. Seven o'clock, about twenty-three dollars.",
   "groups": [
    2,
    4,
    2,
    3
   ]
  },
  {
   "i": 3,
   "s": 11.275,
   "e": 13.025,
   "text": "After dinner, you go dancing.",
   "groups": [
    2,
    3
   ]
  },
  {
   "i": 4,
   "s": 13.175,
   "e": 16.55,
   "text": "Night Tales, at The Spotlight. Ten o'clock, about twenty-five.",
   "groups": [
    2,
    3,
    2,
    2
   ]
  },
  {
   "i": 5,
   "s": 16.7,
   "e": 19.125,
   "text": "Saturday's party won't say where it is yet.",
   "groups": [
    2,
    2,
    4
   ]
  },
  {
   "i": 6,
   "s": 19.275,
   "e": 22.9,
   "text": "Midnight Lovers. Eleven forty-five, about thirty-five dollars.",
   "groups": [
    2,
    2,
    3
   ]
  },
  {
   "i": 7,
   "s": 23.05,
   "e": 25.025,
   "text": "Sunday, you recover on a rooftop.",
   "groups": [
    1,
    2,
    3
   ]
  },
  {
   "i": 8,
   "s": 25.175,
   "e": 28.575,
   "text": "Brunch and football on Sunset, from eleven. That one's free.",
   "groups": [
    3,
    2,
    2,
    3
   ]
  },
  {
   "i": 9,
   "s": 28.725,
   "e": 32.625,
   "text": "All four of these are in Pixie. Send this to whoever plans your weekend.",
   "groups": [
    4,
    3,
    2,
    3,
    2
   ]
  }
 ],
