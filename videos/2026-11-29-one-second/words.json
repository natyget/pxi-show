{
 "duration": 29.662,
 "lines": [
  {
   "i": 0,
   "s": 0.25,
   "e": 2.581,
   "text": "Why are you dressed like that on a Sunday?",
   "groups": [
    3,
    3,
    3
   ],
   "who": "maya",
   "file": "vo/line00.wav"
  },
  {
   "i": 1,
   "s": 2.681,
   "e": 6.693,
   "text": "There's an after hours tonight at eleven, and it's free. Look.",
   "groups": [
    3,
    2,
    2,
    3,
    1
   ],
   "who": "nio",
   "file": "vo/line01.wav"
  },
  {
   "i": 2,
   "s": 6.793,
   "e": 9.083,
   "text": "You have never once been awake at eleven.",
   "groups": [
    3,
    3,
    2
   ],
   "who": "maya",
   "file": "vo/line02.wav"
  },
  {
   "i": 3,
   "s": 9.233,
   "e": 11.422,
   "text": "I stayed up until two on New Year's Eve.",
   "groups": [
    3,
    3,
    3
   ],
   "who": "nio",
   "file": "vo/line03.wav"
  },
  {
   "i": 4,
   "s": 11.522,
   "e": 14.454,
   "text": "You fell asleep at ten, and we drew a moustache on you.",
   "groups": [
    3,
    2,
    3,
    2,
    2
   ],
   "who": "maya",
   "file": "vo/line04.wav"
  },
  {
   "i": 5,
   "s": 14.604,
   "e": 16.879,
   "text": "That was a nap, and tonight I am locked in.",
   "groups": [
    2,
    2,
    3,
    3
   ],
   "who": "nio",
   "file": "vo/line05.wav"
  },
  {
   "i": 6,
   "s": 17.029,
   "e": 19.382,
   "text": "I'm just going to sit down for one second.",
   "groups": [
    3,
    3,
    3
   ],
   "who": "nio",
   "file": "vo/line06.wav"
  },
  {
   "i": 7,
   "s": 19.882,
   "e": 22.916,
   "text": "Nine thirty-one. That's a new record for him.",
   "groups": [
    2,
    3,
    3
   ],
   "who": "maya",
   "file": "vo/line07.wav"
  },
  {
   "i": 8,
   "s": 23.216,
   "e": 25.262,
   "text": "Somebody hand me the marker again.",
   "groups": [
    3,
    3
   ],
   "who": "maya",
   "file": "vo/line08.wav"
  }
 ],
