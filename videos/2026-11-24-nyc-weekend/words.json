 "lines": [
  {
   "i": 0,
   "s": 0.25,
   "e": 5.1,
   "text": "Four things to do in New York this weekend. The last one is free."
  },
  {
   "i": 1,
   "s": 5.45,
   "e": 11.825,
   "text": "Friday night, Marco Leece is at the Public Hotel. House music from eight, twenty dollars."
  },
  {
   "i": 2,
   "s": 12.125,
   "e": 19.3,
   "text": "Saturday, you can skate. Xanadu in Brooklyn, with Rich Medina. Seven o'clock, twenty-five dollars."
  },
  {
   "i": 3,
   "s": 19.6,
   "e": 25.85,
   "text": "Sunday afternoon is Theo Parrish at Nowadays. It starts at three and costs twenty."
  },
  {
   "i": 4,
   "s": 26.15,
   "e": 31.975,
   "text": "And the free one: Reggaeton on Houston, Sunday at five, at San Antonios."
  },
  {
   "i": 5,
   "s": 32.425,
   "e": 36.05,
   "text": "There's more where those came from. It's all in Pixie."
  },
  {
   "i": 6,
   "s": 36.35,
   "e": 38.725,
   "text": "Which one are you going to?"
  }
 ],
