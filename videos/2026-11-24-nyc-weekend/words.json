 "lines": [
  {
   "i": 0,
   "s": 0.25,
   "e": 5.0,
   "text": "Four things to do in New York this weekend. One of them is free."
  },
  {
   "i": 1,
   "s": 5.35,
   "e": 11.275,
   "text": "Friday at eight: Marco Leece, at the Public Hotel. House music, twenty dollars."
  },
  {
   "i": 2,
   "s": 11.575,
   "e": 18.525,
   "text": "Saturday, you can skate. Xanadu in Brooklyn, with Rich Medina, from seven. Twenty-five dollars."
  },
  {
   "i": 3,
   "s": 18.825,
   "e": 24.875,
   "text": "Or pay nothing: a free rave with an arcade, Saturday at nine, at Danger Danger."
  },
  {
   "i": 4,
   "s": 25.175,
   "e": 30.525,
   "text": "Sunday is Theo Parrish, all day at Nowadays, from three. Twenty dollars."
  },
  {
   "i": 5,
   "s": 30.975,
   "e": 34.95,
   "text": "All four are in Pixie, with the rest of your weekend."
  },
  {
   "i": 6,
   "s": 35.25,
   "e": 37.625,
   "text": "Which one are you going to?"
  }
 ],
