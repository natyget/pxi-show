   "i": 0,
   "s": 0.25,
   "e": 3.7,
   "text": "Are you in L.A.? There's a party Saturday that won't say where it is.",
   "groups": [
    4,
    4,
    3,
    3
   ]
  },
  {
   "i": 1,
   "s": 3.85,
   "e": 6.625,
   "text": "Your friend asks where. Nobody knows. You're both in.",
   "groups": [
    4,
    2,
    3
   ]
  },
  {
   "i": 2,
   "s": 6.775,
   "e": 10.125,
   "text": "It's called Midnight Lovers. House music, quarter to midnight.",
   "groups": [
    2,
    2,
    2,
    3
   ]
  },
  {
   "i": 3,
   "s": 10.275,
   "e": 13.925,
   "text": "About thirty-five bucks, and it's on Pixie with the rest of your weekend.",
   "groups": [
    3,
