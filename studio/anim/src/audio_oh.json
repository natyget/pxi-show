{"lines": {"oh_01": {"file": "vo/oh_01.wav", "who": "profh", "sub": "Great sesh, fam. Real ones come to office hours.", "dur": 4.729, "text": "great sesh fam real ones come to office hours"}, "oh_02": {"file": "vo/oh_02.wav", "who": "profh", "sub": "Nio. Today.", "dur": 2.314, "text": "nio today"}, "oh_03": {"file": "vo/oh_03.wav", "who": "theo", "sub": "Bro's not coming back.", "dur": 1.795, "text": "bro's not coming back"}, "oh_04": {"file": "vo/oh_04.wav", "who": "nio", "sub": "It says hours. Plural. That's a suggestion.", "dur": 5.403, "text": "it says hours plural that's a suggestion"}, "oh_05": {"file": "vo/oh_05.wav", "who": "theo", "sub": "Darnell said that.", "dur": 1.259, "text": "darnell said that"}, "oh_06": {"file": "vo/oh_06.wav", "who": "nio", "sub": "Who's Darnell?", "dur": 1.462, "text": "who's darnell"}, "oh_07": {"file": "vo/oh_07.wav", "who": "nio", "sub": "...Pickup's at five.", "dur": 1.035, "text": "pickup's at five"}, "oh_08": {"file": "vo/oh_08.wav", "who": "nio", "sub": "No.", "dur": 0.592, "text": "no"}, "oh_09": {"file": "vo/oh_09.wav", "who": "nio", "sub": "I did not RSVP to that.", "dur": 2.155, "text": "i did not rsvp to that"}, "oh_10": {"file": "vo/oh_10.wav", "who": "cleaner", "sub": "Just go in, baby. It's faster.", "dur": 2.209, "text": "just go in baby it's faster"}, "oh_11": {"file": "vo/oh_11.wav", "who": "darnell", "sub": "First time?", "dur": 0.694, "text": "first time"}, "oh_12": {"file": "vo/oh_12.wav", "who": "nio", "sub": "I'm not even here.", "dur": 1.246, "text": "i'm not even here"}, "oh_13": {"file": "vo/oh_13.wav", "who": "darnell", "sub": "Yeah. We all were.", "dur": 2.206, "text": "yeah we all were"}, "oh_14": {"file": "vo/oh_14.wav", "who": "darnell", "sub": "Did they ever drop the new GTA?", "dur": 2.792, "text": "did they ever drop the new gta"}, "oh_15": {"file": "vo/oh_15.wav", "who": "nio", "sub": "...Not yet, bro.", "dur": 1.209, "text": "not yet bro"}, "oh_16": {"file": "vo/oh_16.wav", "who": "profh", "sub": "Nio! Come in, come in.", "dur": 2.262, "text": "nio come in come in"}, "oh_17": {"file": "vo/oh_17.wav", "who": "profh", "sub": "So. I wanted a word.", "dur": 2.416, "text": "so i wanted a word"}, "oh_18": {"file": "vo/oh_18.wav", "who": "profh", "sub": "Would you come?", "dur": 0.856, "text": "would you come"}, "oh_19": {"file": "vo/oh_19.wav", "who": "nio", "sub": "...Sure.", "dur": 0.657, "text": "sure"}, "oh_20": {"file": "vo/oh_20.wav", "who": "profh", "sub": "Nobody's ever said yes.", "dur": 2.328, "text": "nobody's ever said yes"}, "oh_21": {"file": "vo/oh_21.wav", "who": "profh", "sub": "Same time next week?", "dur": 1.411, "text": "same time next week"}, "oh_22": {"file": "vo/oh_22.wav", "who": "theo", "sub": "Where were you?", "dur": 0.886, "text": "where were you"}, "oh_23": {"file": "vo/oh_23.wav", "who": "nio", "sub": "Office hours.", "dur": 1.185, "text": "office hours"}, "oh_24": {"file": "vo/oh_24.wav", "who": "nio", "sub": "You're coming to improv Thursday.", "dur": 1.701, "text": "you're coming to improv thursday"}, "oh_25": {"file": "vo/oh_25.wav", "who": "profh", "sub": "Nio. Office hours. Today.", "dur": 3.796}, "oh_26": {"file": "vo/oh_26.wav", "who": "nio", "sub": "Game's at five.", "dur": 1.087}}}