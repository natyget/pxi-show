{"lines": {"oh_01": {"file": "vo/oh_01.wav", "who": "profh", "sub": "Great sesh, fam. Real ones come to office hours.", "dur": 4.729, "text": "great sesh fam real ones come to office hours"}, "oh_02": {"file": "vo/oh_02.wav", "who": "profh", "sub": "Nio. Today.", "dur": 2.314, "text": "nio today"}, "oh_03": {"file": "vo/oh_03.wav", "who": "theo", "sub": "Bro's not coming back.", "dur": 1.795, "text": "bro's not coming back"}, "oh_04": {"file": "vo/oh_04.wav", "who": "nio", "sub": "It says hours. Plural. That's a suggestion.", "dur": 5.403, "text": "it says hours plural that's a suggestion"}, "oh_05": {"file": "vo/oh_05.wav", "who": "theo", "sub": "Darnell said that.", "dur": 1.259, "text": "darnell said that"}, "oh_06": {"file": "vo/oh_06.wav", "who": "nio", "sub": "Who's Darnell?", "dur": 1.462, "text": "who's darnell"}, "oh_07": {"file": "vo/oh_07.wav", "who": "nio", "sub": "...Pickup's at five.", "dur": 1.035, "text": "pickup's at five"}, "oh_08": {"file": "vo/oh_08.wav", "who": "nio", "sub": "No.", "dur": 0.592, "text": "no"}, "oh_09": {"file": "vo/oh_09.wav", "who": "nio", "sub": "I did not RSVP to that.", "dur": 2.155, "text": "i did not rsvp to that"}, "oh_10": {"file": "vo/oh_10.wav", "who": "cleaner", "sub": "Just go in, baby. It's faster.", "dur": 2.209, "text": "just go in baby it's faster"}, "oh_11": {"file": "vo/oh_11.wav", "who": "darnell", "sub": "First time?", "dur": 0.694, "text": "first time"}, "oh_12": {"file": "vo/oh_12.wav", "who": "nio", "sub": "I'm not even here.", "dur": 1.246, "text": "i'm not even here"}, "oh_13": {"file": "vo/oh_13.wav", "who": "darnell", "sub": "Yeah. We all were.", "dur": 2.206, "text": "yeah we all were"}, "oh_14": {"file": "vo/oh_14.wav", "who": "darnell", "sub": "Did they ever drop the new GTA?", "dur": 2.792, "text": "did they ever drop the new gta"}, "oh_15": {"file": "vo/oh_15.wav", "who": "nio", "sub": "...Not yet, bro.", "dur": 1.209, "text": "not yet bro"}, "oh_16": {"file": "vo/oh_16.wav", "who": "profh", "sub": "Nio! Come in, come in.", "dur": 2.262, "text": "nio come in come in"}, "oh_17": {"file": "vo/oh_17.wav", "who": "profh", "sub": "So. I wanted a word.", "dur": 2.416, "text": "so i wanted a word"}, "oh_18": {"file": "vo/oh_18.wav", "who": "profh", "sub": "Would you come?", "dur": 0.856, "text": "would you come"}, "oh_19": {"file": "vo/oh_19.wav", "who": "nio", "sub": "...Sure.", "dur": 0.657, "text": "sure"}, "oh_20": {"file": "vo/oh_20.wav", "who": "profh", "sub": "Nobody's ever said yes.", "dur": 2.328, "text": "nobody's ever said yes"}, "oh_21": {"file": "vo/oh_21.wav", "who": "profh", "sub": "Same time next week?", "dur": 1.411, "text": "same time next week"}, "oh_22": {"file": "vo/oh_22.wav", "who": "theo", "sub": "Where were you?", "dur": 0.886, "text": "where were you"}, "oh_23": {"file": "vo/oh_23.wav", "who": "nio", "sub": "Office hours.", "dur": 1.185, "text": "office hours"}, "oh_24": {"file": "vo/oh_24.wav", "who": "nio", "sub": "You're coming to improv Thursday.", "dur": 1.701, "text": "you're coming to improv thursday"}, "oh_25": {"file": "vo/oh_25.wav", "who": "profh", "sub": "Nio. Office hours. Today.", "dur": 3.796, "text": "Nio. Office hours. Today."}, "oh_26": {"file": "vo/oh_26.wav", "who": "nio", "sub": "Game's at five.", "dur": 1.087, "text": "Game's at five."}, "v5_01": {"file": "vo/v5_01.wav", "who": "profh", "sub": "Nio! Can you swing by my office hours after class? It won't take a minute.", "dur": 5.564, "text": "Nio! Can you swing by my office hours after class? It won't take a minute."}, "v5_02": {"file": "vo/v5_02.wav", "who": "maya", "sub": "He picked you. I go every week. He has a candle.", "dur": 4.868, "text": "He picked you. I go every week. He has a candle."}, "v5_03": {"file": "vo/v5_03.wav", "who": "nio", "sub": "Maya. The final's at five. If I'm not on that pitch, we forfeit.", "dur": 4.809, "text": "Maya. The final's at five. If I'm not on that pitch, we forfeit."}, "v5_04": {"file": "vo/v5_04.wav", "who": "maya", "sub": "It's one minute!", "dur": 0.977, "text": "It's one minute!"}, "v5_05": {"file": "vo/v5_05.wav", "who": "nio", "sub": "That's how they get you. It's one minute, then you're forty, and it's still office hours.", "dur": 5.806, "text": "That's how they get you. It's one minute, then you're forty, and it's still office hours."}, "v5_06": {"file": "vo/v5_06.wav", "who": "maya", "sub": "That's not a real thing.", "dur": 1.396, "text": "That's not a real thing."}, "v5_07": {"file": "vo/v5_07.wav", "who": "nio", "sub": "In a world... where one minute... is forever.", "dur": 3.728, "text": "In a world... where one minute... is forever."}, "v5_08": {"file": "vo/v5_08.wav", "who": "nio", "sub": "Office Hours. Now showing. Always.", "dur": 3.866, "text": "Office Hours. Now showing. Always."}, "v5_09": {"file": "vo/v5_09.wav", "who": "maya", "sub": "Did you just do a trailer?", "dur": 2.269, "text": "Did you just do a trailer?"}, "v5_10": {"file": "vo/v5_10.wav", "who": "nio", "sub": "I'm going out the back.", "dur": 1.399, "text": "I'm going out the back."}, "v5_11": {"file": "vo/v5_11.wav", "who": "maya", "sub": "I'll come!", "dur": 0.941, "text": "I'll come!"}, "v5_12": {"file": "vo/v5_12.wav", "who": "maya", "sub": "Oh, I love this hallway.", "dur": 1.824, "text": "Oh, I love this hallway."}, "v5_13": {"file": "vo/v5_13.wav", "who": "nio", "sub": "It's the trailer. We're in the trailer.", "dur": 2.139, "text": "It's the trailer. We're in the trailer."}, "v5_14": {"file": "vo/v5_14.wav", "who": "maya", "sub": "You're being dramatic.", "dur": 1.26, "text": "You're being dramatic."}, "v5_15": {"file": "vo/v5_15.wav", "who": "cleaner", "sub": "Nobody goes past it, baby.", "dur": 1.663, "text": "Nobody goes past it, baby."}, "v5_16": {"file": "vo/v5_16.wav", "who": "maya", "sub": "Darnell! How's the thesis?", "dur": 2.491, "text": "Darnell! How's the thesis?"}, "v5_17": {"file": "vo/v5_17.wav", "who": "darnell", "sub": "Hey, Maya. I'm next.", "dur": 3.268, "text": "Hey, Maya. I'm next."}, "v5_18": {"file": "vo/v5_18.wav", "who": "nio", "sub": "How long have you been next?", "dur": 1.495, "text": "How long have you been next?"}, "v5_19": {"file": "vo/v5_19.wav", "who": "darnell", "sub": "Since freshman year.", "dur": 1.184, "text": "Since freshman year."}, "v5_20": {"file": "vo/v5_20.wav", "who": "maya", "sub": "See? It moves.", "dur": 1.934, "text": "See? It moves."}, "v5_21": {"file": "vo/v5_21.wav", "who": "profh", "sub": "Nio! Come on in!", "dur": 1.678, "text": "Nio! Come on in!"}, "v5_22": {"file": "vo/v5_22.wav", "who": "profh", "sub": "Would you come? Be honest.", "dur": 2.636, "text": "Would you come? Be honest."}, "v5_23": {"file": "vo/v5_23.wav", "who": "nio", "sub": "...Yeah. I'll come.", "dur": 1.739, "text": "...Yeah. I'll come."}, "v5_24": {"file": "vo/v5_24.wav", "who": "theo", "sub": "...You made it.", "dur": 0.847, "text": "...You made it."}, "v5_25": {"file": "vo/v5_25.wav", "who": "nio", "sub": "Darnell's in goal.", "dur": 1.368, "text": "Darnell's in goal."}}}